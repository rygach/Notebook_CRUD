{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-msys2",
      "displayName": "Debug (MSYS2 MinGW64)",
      "description": "Debug build using MSYS2 MinGW64 toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe"
      },
      "environment": {
        "PATH": "C:\\msys64\\mingw64\\bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-msys2",
      "configurePreset": "debug-msys2"
    }
  ]
}


