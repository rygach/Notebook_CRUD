# Настройки Git для правильной обработки файлов

# Автоматическое определение текстовых файлов
* text=auto

# Исходные файлы
*.cpp text
*.h text
*.c text
*.hpp text
*.qml text
*.js text

# Конфигурационные файлы
*.cmake text
*.txt text
*.json text
*.xml text
*.qrc text
*.md text
*.yml text
*.yaml text

# Скрипты
*.sh text eol=lf
*.bat text eol=crlf

# Бинарные файлы
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.dylib binary
*.o binary
*.obj binary

# Изображения
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Архивы
*.zip binary
*.tar binary
*.gz binary
*.7z binary

